# FieldVision host/config template — copy to `.env` and fill in real values.
#
#     cp fieldvision/.env.example fieldvision/.env
#
# `.env` is gitignored and MUST stay that way: it holds the private-network
# addresses and account names for the lab hardware. This repo is public, so
# nothing here may contain a real hostname, IP, or username.
#
# Consumed by scripts/nellie_autopilot.sh (which sources it) and read via
# os.environ by the Python entrypoints. Every value below has a safe default
# derived from $HOME / $USER, so a fresh clone runs without a `.env` at all.

# --- Compute host (the machine that runs capture) -------------------------
# Reachable only from the home VPN.
NELLIE_HOST=10.0.0.1          # placeholder — real address goes in .env
NELLIE_USER=youruser
NELLIE_SSH_ALIAS=nellie       # the Host entry in your ~/.ssh/config

# --- NAS (CIFS shares mounted at /media/{scratch,datasets}) ---------------
NAS_HOST=10.0.0.2             # placeholder — real address goes in .env

# --- Storage roots --------------------------------------------------------
# Raw data on the datasets share; transient samples + state on scratch.
FV_DATASET_ROOT=/media/datasets/$USER/fieldvision
FV_SCRATCH_ROOT=/media/scratch/$USER/fieldvision
FV_DATA_DIR=$FV_DATASET_ROOT/data
FV_STATE_DIR=$FV_SCRATCH_ROOT/state
FV_SAMPLES_DIR=$FV_SCRATCH_ROOT/samples

# --- Private, local-disk-only paths ---------------------------------------
# Secrets NEVER go on the NAS (world-readable). Logs stay on local disk:
# CIFS-bound logging can SIGPIPE-kill a daemon under NAS I/O load.
FV_TOKEN_FILE=$HOME/.fv_token.txt
FV_COOKIE_FILE=$HOME/.fv_okta_cookies.json
FV_LOG_DIR=$HOME/logs
FV_DASHBOARD_ROOT=$HOME/dashboard

# --- Capture window -------------------------------------------------------
FV_BACKLOG_START=2026-04-14
FV_DASHBOARD_PORT=8377
