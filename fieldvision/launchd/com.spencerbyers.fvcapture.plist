<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- launchd does NOT shell-expand plist strings — $HOME/$USER-style
     references below are inert. Replace YOUR_USERNAME with your real
     macOS account name before installing this job (retired; kept as a
     manual-fallback template, see fieldvision/CLAUDE.md). -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.spencerbyers.fvcapture</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/YOUR_USERNAME/anaconda3/envs/baseball/bin/python</string>
        <string>-u</string>
        <string>/Users/YOUR_USERNAME/fieldvision/scripts/fv_daemon.py</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/YOUR_USERNAME/fieldvision</string>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <key>ThrottleInterval</key>
    <integer>30</integer>

    <key>StandardOutPath</key>
    <string>/Users/YOUR_USERNAME/fieldvision/scheduler.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/YOUR_USERNAME/fieldvision/scheduler.err</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>HOME</key>
        <string>/Users/YOUR_USERNAME</string>
        <key>USER</key>
        <string>YOUR_USERNAME</string>
        <key>PATH</key>
        <string>/Users/YOUR_USERNAME/anaconda3/envs/baseball/bin:/Users/YOUR_USERNAME/anaconda3/bin:/usr/local/bin:/usr/bin:/bin</string>
    </dict>
</dict>
</plist>
